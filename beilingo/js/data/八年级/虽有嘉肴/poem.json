{
  "id": "sjyx",
  "title": "虽有嘉肴",
  "author": [
    "西汉",
    "戴圣"
  ],
  "couplets": [
    [
      "虽有嘉肴",
      "弗食不知其旨也"
    ],
    [
      "虽有至道",
      "弗学不知其善也"
    ],
    [
      "是故学然后知不足",
      "教然后知困"
    ],
    [
      "知不足然后能自反也",
      "知困然后能自强也"
    ],
    [
      "故曰教学相长也",
      "兑命曰学学半"
    ],
    [
      "其此之谓乎",
      ""
    ]
  ]
}