{
  "id": "xstj",
  "title": "小石潭记",
  "author": [
    "唐",
    "柳宗元"
  ],
  "couplets": [
    [
      "从小丘西行百二十步",
      "隔篁竹闻水声如鸣珮环心乐之"
    ],
    [
      "伐竹取道下见小潭",
      "水尤清冽"
    ],
    [
      "全石以为底",
      "近岸卷石底以出"
    ],
    [
      "为坻为屿为嵁为岩",
      "青树翠蔓蒙络摇缀参差披拂"
    ],
    [
      "潭中鱼可百许头",
      "皆若空游无所依"
    ],
    [
      "日光下澈影布石上",
      "佁然不动"
    ],
    [
      "俶尔远逝往来翕忽",
      "似与游者相乐"
    ],
    [
      "潭西南而望",
      "斗折蛇行明灭可见"
    ],
    [
      "其岸势犬牙差互",
      "不可知其源"
    ],
    [
      "坐潭上四面竹树环合",
      "寂寥无人凄神寒骨悄怆幽邃"
    ],
    [
      "以其境过清不可久居",
      "乃记之而去"
    ],
    [
      "同游者吴武陵龚古余弟宗玄",
      "隶而从者崔氏二小生曰恕己曰奉壹"
    ]
  ]
}