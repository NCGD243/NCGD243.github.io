{
  "id": "jczmzcsl",
  "title": "江城子·密州出猎",
  "author": [
    "宋",
    "苏轼"
  ],
  "couplets": [
    [
      "老夫聊发少年狂",
      "左牵黄右擎苍"
    ],
    [
      "锦帽貂裘",
      "千骑卷平冈"
    ],
    [
      "为报倾城随太守",
      "亲射虎看孙郎"
    ],
    [
      "酒酣胸胆尚开张",
      "鬓微霜又何妨"
    ],
    [
      "持节云中",
      "何日遣冯唐"
    ],
    [
      "会挽雕弓如满月",
      "西北望射天狼"
    ]
  ]
}