{
  "id": "xlqy",
  "title": "行路难（其一）",
  "author": [
    "唐",
    "李白"
  ],
  "couplets": [
    [
      "金樽清酒斗十千",
      "玉盘珍羞直万钱"
    ],
    [
      "停杯投箸不能食",
      "拔剑四顾心茫然"
    ],
    [
      "欲渡黄河冰塞川",
      "将登太行雪满山"
    ],
    [
      "闲来垂钓碧溪上",
      "忽复乘舟梦日边"
    ],
    [
      "行路难行路难多歧路今安在",
      "长风破浪会有时直挂云帆济沧海"
    ]
  ]
}