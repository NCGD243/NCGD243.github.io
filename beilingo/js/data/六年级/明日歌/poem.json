{
  "id": "mrg",
  "title": "明日歌",
  "author": [
    "明",
    "钱福"
  ],
  "couplets": [
    [
      "明日复明日",
      "明日何其多"
    ],
    [
      "我生待明日",
      "万事成蹉跎"
    ],
    [
      "世人若被明日累",
      "春去秋来老将至"
    ],
    [
      "朝看水东流",
      "暮看日西坠"
    ],
    [
      "百年明日能几何",
      "请君听我明日歌"
    ]
  ]
}